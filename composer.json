{
  "name": "getsidekicker/flagr-client",
  "description": "Flagr is a feature flagging, A/B testing and dynamic configuration microservice. The base path for all the APIs is \"/api/v1\".",
  "keywords": [
    "flagr",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/getsidekicker/flagr-client",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^6.2 || ^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "rector/rector": "^2.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Flagr\\Client\\": "lib/"
    }
  },
  "scripts": {
    "fixer": "vendor/bin/php-cs-fixer fix --config=./.php_cs.php --using-cache=no",
    "rector": "vendor/bin/rector process lib",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
